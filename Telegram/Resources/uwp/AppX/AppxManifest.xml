<?xml version="1.0" encoding="utf-8"?>
<Package
   xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
   xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
   xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
   xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
   xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
   xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
   IgnorableNamespaces="uap uap2 uap3 desktop rescap">
  <!-- Partner Center assigns Identity Name, Publisher and
       PublisherDisplayName when the name Lumigram is reserved (Product
       management > Product identity). Replace these placeholders with
       those values before submitting a package to the Store. -->
  <Identity Name="KakunArtem.Lumigram"
    ProcessorArchitecture="ARCHITECTURE"
    Publisher="CN=00000000-0000-0000-0000-000000000000"
    Version="7.4.5.0" />
  <Properties>
    <DisplayName>Lumigram</DisplayName>
    <PublisherDisplayName>KakunArtem</PublisherDisplayName>
    <Description>Lumigram, an unofficial Telegram client for Windows 11</Description>
    <Logo>Assets\logo\logo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
  </Capabilities>
  <Applications>
    <Application Id="Lumigram.Lumigram.Store" Executable="Lumigram.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
       BackgroundColor="transparent"
       DisplayName="Lumigram"
       Square150x150Logo="Assets\logo150\logo150.png"
       Square44x44Logo="Assets\logo44\logo44.png"
       Description="Lumigram, an unofficial Telegram client for Windows 11" />
      <Extensions>
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="tg" Parameters="-- &quot;%1&quot;" />
        </uap3:Extension>
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="tonsite" Parameters="-- &quot;%1&quot;" />
        </uap3:Extension>
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="ton" Parameters="-- &quot;%1&quot;" />
        </uap3:Extension>
        <desktop:Extension
          Category="windows.startupTask"
          Executable="StartupTask.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="LumigramStartupTask"
            Enabled="false"
            DisplayName="Lumigram" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
